# Modelo das variáveis de ambiente. Copie para .env.local e preencha; .env.local não vai para o git.

# Públicas: vão para o navegador (dados públicos, protegidos por RLS de só leitura).
NEXT_PUBLIC_SUPABASE_URL=
# A chave publishable (sb_publishable_…). O nome antigo, NEXT_PUBLIC_SUPABASE_ANON_KEY, também é aceito.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Só para o script de carga local (scripts/backfill-precos.ts).
# A chave secreta (sb_secret_…) é segredo de servidor: NUNCA use o prefixo NEXT_PUBLIC_ nela, nem a
# configure na Vercel (Princípio II).
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: sem ela, o script usa a NEXT_PUBLIC_SUPABASE_URL (a URL é pública).
SUPABASE_URL=

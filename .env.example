# Modelo das variáveis de ambiente. Copie para .env.local e preencha; .env.local não vai para o git.

# Públicas: vão para o navegador (dados públicos, protegidos por RLS de só leitura).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Só para o script de carga local (scripts/backfill-precos.ts). São segredos de servidor:
# NUNCA use o prefixo NEXT_PUBLIC_ nelas, nem as configure na Vercel (Princípio II).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
